# העתק את הקובץ הזה ל-.env.local ומלא את הערכים מ-Supabase:
# כתובת ה-URL הציבורית של האתר (ללא סלאש בסוף) — לשימוש ב-og:url בתגי Open Graph
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# מפתח סודי — לעולם לא לשתף ולא להעלות ל-GitHub
SUPABASE_SERVICE_ROLE_KEY=

# ── WhatsApp Cloud API (Meta) — server-only, never expose to the client ────────
# Meta Developer Console > Your App > WhatsApp > API Setup
# אם לא מוגדרים, אפשרות "שליחה אוטומטית" לא מוצגת (השליחה בלחיצה ממשיכה לעבוד).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
# App Secret — לאימות חתימת webhook
WHATSAPP_APP_SECRET=
# App ID — נדרש להעלאת תמונת דוגמה לתבניות (Meta Developer Console > App Dashboard)
WHATSAPP_APP_ID=
# Verify Token — מחרוזת סודית שאתה בוחר, להגדיר גם ב-Meta webhook
WHATSAPP_VERIFY_TOKEN=
# גרסת Graph API (ברירת מחדל: v25.0)
WHATSAPP_GRAPH_VERSION=v25.0
# מגבלה יומית — מספר הודעות API מקסימלי ב-24 שעות (ברירת מחדל: 250)
WHATSAPP_DAILY_LIMIT=250
# true = לא שולח באמת, רק מדפיס ל-console (לפיתוח)
WHATSAPP_DRY_RUN=true
